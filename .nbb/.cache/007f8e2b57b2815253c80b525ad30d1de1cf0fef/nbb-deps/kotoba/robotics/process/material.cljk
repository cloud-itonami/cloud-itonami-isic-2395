(ns kotoba.robotics.process.material
  "A robot-run tension (or, with a negative force, compression) test of a
  prismatic specimen, solved by kudaki's explicit nonlinear structural
  dynamics: a bar of `:elements` J2-plastic truss elements, one end fixed,
  the other loaded by a force ramped linearly to `:max-force-n` over a time
  long enough (`:ramp-transits` wave transits) to be quasi-static.

  Unlike a one-tick rigid-body stop, the answer depends on the specimen: its
  length, section, Young's modulus, yield stress and hardening. The force-
  elongation curve is read from kudaki's history frames; elastic stiffness,
  the 0.2 %-offset yield load (Rp0.2), the final
  elongation and the plastic energy are derived from it.

  Held to (tests): elastic stiffness within 2 % of EA/L; a specimen loaded
  below sigma_y*A never yields; the detected yield load within 5 % of
  sigma_y*A (0.2 % offset, with hardening H adding H*0.002*A);
  kudaki's own energy balance residual small."
  (:require [kudaki.integrate :as itg]))

(def defaults
  {:length-m 0.10 :area-m2 1.0e-4 :youngs-modulus-pa 200.0e9 :yield-stress-pa 250.0e6
   :hardening-pa 1.0e9 :density-kg-m3 7850.0 :max-force-n 30000.0
   :elements 8 :ramp-transits 400.0 :frames 200})

(defn- bar [{:keys [elements length-m area-m2 youngs-modulus-pa yield-stress-pa hardening-pa density-kg-m3]}]
  (let [n (long elements) a (/ length-m n)]
    {:nodes (into {} (map (fn [i] [i [(* i a) 0.0 0.0]]) (range (inc n))))
     :elements (mapv (fn [i] {:type :truss :nodes [i (inc i)] :mat :m :section {:area area-m2}}) (range n))
     :materials {:m {:type :j2 :E youngs-modulus-pa :density density-kg-m3
                     :yield yield-stress-pa :hardening hardening-pa}}}))

(defn tensile-test
  "Run the test. Returns scalar quantities plus `:curve` [[force elongation] ...]."
  [params]
  (let [p (merge defaults params)
        {:keys [elements length-m area-m2 youngs-modulus-pa yield-stress-pa density-kg-m3
                max-force-n ramp-transits frames]} p
        n (long elements)
        c (Math/sqrt (/ youngs-modulus-pa density-kg-m3))
        a (/ length-m n)
        dt (* 0.8 (/ a c))
        ramp (* ramp-transits (/ length-m c))
        steps (long (Math/ceil (/ ramp dt)))
        force-at (fn [t] (* max-force-n (min 1.0 (/ t ramp))))
        res (itg/run (bar p)
                     {:dt dt :steps steps :sample-every (max 1 (quot steps frames))
                      :fixed (into {0 [true true true]} (map (fn [i] [i [false true true]]) (range 1 (inc n))))
                      :f-ext (fn [t] {n [(force-at t) 0.0 0.0]})})
        curve (mapv (fn [{:keys [t pos]}] [(force-at t) (- (get-in pos [n 0]) length-m)]) (:history res))
        k-theory (/ (* youngs-modulus-pa area-m2) length-m)
        ;; stiffness: least squares through the origin over 5-25 % of the peak
        ;; load (inside elastic for any test that yields past 25 %); the explicit
        ;; solver is undamped, so single frames ring around the static answer
        fmax (Math/abs (double max-force-n))
        early (filter (fn [[f u]] (and (not (zero? u)) (<= (* 0.05 fmax) (Math/abs (double f)) (* 0.25 fmax)))) curve)
        k (when (seq early)
            (/ (reduce + (map (fn [[f u]] (* f u)) early)) (reduce + (map (fn [[_ u]] (* u u)) early))))
        ;; yield: the 0.2 % offset rule (ISO 6892-1 Rp0.2 / ASTM E8) -- the first
        ;; load from which EVERY later frame carries more than 0.2 % permanent
        ;; strain (elongation beyond the elastic line, over the gauge length).
        ;; A single ringing frame is not yield. (Was: 3 % beyond the line,
        ;; which read 0.9-1.3 % high and passed a 340.6 MPa bar as SD345.)
        offset? (fn [[f u]] (and k (> (- (Math/abs (double u)) (Math/abs (/ f k))) (* 0.002 length-m))))
        tails (map-indexed (fn [i fr] [fr (every? offset? (drop i curve))]) curve)
        yield-f (some (fn [[[f _] all-beyond?]] (when (and all-beyond? (> (Math/abs (double f)) (* 0.05 fmax)))
                                                  (Math/abs (double f))))
                      tails)
        [_ u-end] (last curve)
        eng (:energy res)]
    {:elastic-stiffness-n-per-m k
     :theoretical-stiffness-n-per-m k-theory
     :yield-force-n yield-f
     :yielded? (boolean yield-f)
     :nominal-yield-force-n (* yield-stress-pa area-m2)
     :max-force-n (Math/abs (double max-force-n))
     :final-elongation-m u-end
     :final-strain (/ u-end length-m)
     :plastic-energy-j (:plastic eng)
     :energy-residual-rel (:residual-rel eng)
     :steps steps
     :curve curve}))
